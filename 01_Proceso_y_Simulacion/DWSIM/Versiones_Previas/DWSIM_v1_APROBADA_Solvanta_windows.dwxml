      <DynamicPropertiesDescriptions>
        <Property>
          <Name>Max. P change (%)</Name>
          <PropertyType>System.String</PropertyType>
          <Data>"Maximum Pressure change (in percent) change between iterations"</Data>
        </Property>
        <Property>
          <Name>Max. L change (%)</Name>
          <PropertyType>System.String</PropertyType>
          <Data>"Maximum Liquid Flow change (in percent) change between iterations"</Data>
        </Property>
        <Property>
          <Name>Max. V change (%)</Name>
          <PropertyType>System.String</PropertyType>
          <Data>"Maximum Vapor Flow change (in percent) change between iterations"</Data>
        </Property>
        <Property>
          <Name>Time step discretization</Name>
          <PropertyType>System.String</PropertyType>
          <Data>"Number of sub-steps per integration step for column dynamics."</Data>
        </Property>
        <Property>
          <Name>Souders-Brown Coefficient</Name>
          <PropertyType>System.String</PropertyType>
          <Data>"Souders-Brown coefficient C_SB (m/s) for flooding check. Typical 0.03-0.05 for sieve trays. Set to 0 to disable."</Data>
        </Property>
        <Property>
          <Name>Flooding Alarm</Name>
          <PropertyType>System.String</PropertyType>
          <Data>"True when any stage exceeds the flooding velocity limit."</Data>
        </Property>
        <Property>
          <Name>Weeping Alarm</Name>
          <PropertyType>System.String</PropertyType>
          <Data>"True when any stage vapor velocity is below minimum for tray support."</Data>
        </Property>
        <Property>
          <Name>Apply Murphree Efficiency</Name>
          <PropertyType>System.String</PropertyType>
          <Data>"Apply stage Murphree efficiency to dynamic simulation. Stage efficiency values are used."</Data>
        </Property>
      </DynamicPropertiesDescriptions>
