        <Item Key="flujo_molar_h2_in" Value="0" />
        <Item Key="flujo_molar_h2_prod" Value="171.01968635366975" />
        <Item Key="corriente_por_stack" Value="133.5542220028171" />
        <Item Key="densidad_corriente" Value="8903.614800187808" />
        <Item Key="y_h2o_medio" Value="0.65" />
        <Item Key="y_h2_medio" Value="0.35" />
        <Item Key="y_o2_medio" Value="1" />
        <Item Key="delta_g0" Value="191211.04810173783" />
        <Item Key="delta_h0" Value="248000" />
        <Item Key="e_rev_std" Value="0.9908814319254572" />
        <Item Key="v_tn" Value="1.2851694374205984" />
        <Item Key="e_nernst" Value="1.0296237459407949" />
        <Item Key="eta_act" Value="0.32177888693030926" />
        <Item Key="eta_ohm" Value="0.19587952941447836" />
        <Item Key="eta_conc" Value="0.019409405964083984" />
        <Item Key="v_celda" Value="1.5666915682496665" />
        <Item Key="v_stack" Value="156.66915682496665" />
        <Item Key="potencia_dc_total_w" Value="52225873.06958303" />
        <Item Key="potencia_total_kw" Value="52225.87306958303" />
        <Item Key="potencia_ac_total_kw" Value="54401.95111414899" />
        <Item Key="flujo_masico_h2_kgs" Value="0.34475516532663575" />
        <Item Key="flujo_masico_h2_kgh" Value="1241.1185951758887" />
        <Item Key="sec_stack" Value="42.07967979255173" />
        <Item Key="sec_sistema" Value="43.83299978390805" />
        <Item Key="calor_termico_kw" Value="9384.57790219909" />
        <Item Key="flujo_molar_h2_out" Value="171.01968635366975" />
        <Item Key="flujo_molar_h2o_out" Value="73.2941512944299" />
        <Item Key="flujo_molar_o2_out" Value="85.50984317683488" />
        <Item Key="presion_out" Value="1940000" />
        <Item Key="temperatura_out" Value="1023.1499981187533" />
        <Item Key="flujo_cat_total" Value="244.31383764809965" />
      </OutputVariables>
